<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External storage for pictures -->
    <external-path
        name="external_files"
        path="." />
    
    <!-- Pictures directory -->
    <external-files-path
        name="pictures"
        path="Pictures/" />
    
    <!-- Cache directory -->
    <cache-path
        name="cache"
        path="." />
    
    <!-- External cache directory -->
    <external-cache-path
        name="external_cache"
        path="." />
</paths>
